# ---------------------------------------------------------------------------
# Legal Case Management Portal — environment template
#
# Copy to `.env` and fill in real values. Every value below is a placeholder;
# NONE of them are usable credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Pooled connection, used by the running application (src/lib/prisma.ts).
DB_PRISMA_URL="postgres://USER:PASSWORD@HOST-pooler.example.com/DBNAME?sslmode=require"
# Direct connection, used by `prisma migrate` / `prisma db push` only.
# Must bypass the pooler or migrations will fail.
DB_URL_NON_POOLING="postgres://USER:PASSWORD@HOST.example.com/DBNAME?sslmode=require"

# --- Auth -----------------------------------------------------------------
# Signs and encrypts the NextAuth session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET="REPLACE_ME_generate_with_openssl_rand_base64_32"

# --- Field-level encryption ------------------------------------------------
# 32-byte key, base64 encoded, for AES-256-GCM encryption of case strategy
# notes and hearing notes at rest (src/lib/crypto.ts).
# Generate with: openssl rand -base64 32
#
# WARNING: rotating this key makes every previously encrypted note
# undecryptable. Plan a re-encryption migration before changing it.
FIELD_ENCRYPTION_KEY="REPLACE_ME_generate_with_openssl_rand_base64_32"

# --- File storage ----------------------------------------------------------
# Vercel Blob read/write token for document uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_REPLACE_ME"

# --- Scheduled jobs --------------------------------------------------------
# Shared secret guarding the hearing-reminder cron endpoint.
# Generate with: openssl rand -hex 24
CRON_SECRET="REPLACE_ME_generate_with_openssl_rand_hex_24"

# --- Branding --------------------------------------------------------------
# Displayed throughout the portal chrome. Safe to expose to the browser.
NEXT_PUBLIC_FIRM_NAME="Vashisth & Associates"
